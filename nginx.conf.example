# Example Nginx Reverse Proxy Configuration for Instaboard
# Place this in /etc/nginx/sites-available/instaboard and symlink to /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name instaboard.yourdomain.com;

    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name instaboard.yourdomain.com;

    # SSL certificates (managed by Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/instaboard.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/instaboard.yourdomain.com/privkey.pem;

    # Optimize client upload size for Instagram zip archives (e.g. 50MB)
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # WebSocket & connection upgrade support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';

        # Forward real client host and IP for accurate QR sync codes
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_cache_bypass $http_upgrade;
    }
}
